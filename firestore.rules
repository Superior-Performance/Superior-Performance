rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requester signed in?
    function isAuth() { return request.auth != null; }

    // Helper: read the requester's role from their user doc
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isAuth() && role() == 'admin'; }
    function isAthlete() { return isAuth() && role() == 'athlete'; }

    // Writes below are gated on isAthlete(), not isAuth(), everywhere an
    // athlete writes their own data. The web API key ships in the bundle and
    // Email/Password signup is enabled (admins create accounts through it),
    // so anyone can mint a signed-in account over the public REST endpoint.
    // Such an account holds no role, owns no data, and is invisible in the
    // admin UI — but under isAuth() it could still write unbounded documents
    // under its own uid and burn the Spark plan's daily write quota, which
    // takes the app down for every real athlete until midnight. Reads stay
    // on isAuth(): they are already scoped to the caller's own uid, and a
    // role-less account has nothing there to read.

    // Users: admins can read/write all; athletes can read only their own doc.
    // Writes are otherwise admin-only — role/programTypes living on this doc
    // make a general self-write a privilege escalation risk — except an
    // athlete may update their OWN doc's photoURL and nothing else (profile
    // photo upload, see AccountPage). affectedKeys().hasOnly(['photoURL'])
    // rejects any write that touches a second field in the same call, so
    // this can't be piggybacked into changing role/etc.
    match /users/{uid} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (
        isAuth() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL'])
      );
    }

    // Programs: admins full access; athletes can only read their own, and only
    // once it's active — draft programs awaiting coach review stay admin-only
    // even for the athlete they're assigned to.
    match /programs/{programId} {
      allow read:  if isAdmin() || (isAthlete() && resource.data.athleteId == request.auth.uid && resource.data.active == true);
      allow write: if isAdmin();
    }

    // Data logs: admins read all; athletes read/write their own
    match /dataLogs/{uid}/entries/{entryId} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (isAthlete() && request.auth.uid == uid);
    }

    // Assessments: admins full access; athletes read-only their own.
    // `history` holds one snapshot per assessment date so a re-screen doesn't
    // overwrite what it should be compared against — same access as the
    // current assessment it came from, since it is the same data.
    match /assessments/{uid} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin();

      match /history/{entryId} {
        allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
        allow write: if isAdmin();
      }
    }

    // Completions: athletes write their own; admins read and write all.
    // Admin writes are needed so editing a live program can move an athlete's
    // existing completions onto stable exercise-id keys (see utils/programIds),
    // and so a coach can correct a mis-tapped checkmark.
    match /completions/{uid}/weeks/{key} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (isAthlete() && request.auth.uid == uid);
    }

    // Athlete-owned UI preferences — dismissed banners and the like. Kept out
    // of users/{uid} on purpose: that doc holds role and is admin-write-only,
    // and nothing here is security-relevant.
    match /athletePrefs/{uid} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (isAthlete() && request.auth.uid == uid);
    }

    // Exercise weight tracking — one editable "this week's weight" value per
    // exercise instance, logged inline on the athlete's program tab so they
    // don't have to leave it mid-workout. Not a history (see dataLogs for
    // that) — same read/write shape as completions.
    match /exerciseWeights/{uid}/entries/{key} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (isAthlete() && request.auth.uid == uid);
    }

    // Chat — one thread per athlete, shared with their coach. Admins can
    // read/write every thread; an athlete can only read/write their own.
    match /chats/{athleteUid}/messages/{messageId} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == athleteUid);
      allow write: if isAdmin() || (isAthlete() && request.auth.uid == athleteUid);
    }

    // Admin-only "coach last opened this thread" marker — the athlete side
    // has no unread state to track, so no athlete-uid branch here at all.
    match /chatReads/{athleteUid} {
      allow read, write: if isAdmin();
    }

    // Team chat: the staff room. Admin-only end to end — athletes have no
    // business reading it and there is deliberately no athlete branch, unlike
    // /chats above. Scheduled Claude agents reach this through an admin
    // credential too, so they need no separate carve-out.
    //
    // Update is restricted to `answeredBy` alone: an agent marks a message
    // as handled, but nobody (agent or human) gets to silently rewrite the
    // text of a message already sitting in everyone else's scrollback.
    // Deletes are refused outright for the same reason.
    match /teamChat/{messageId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answeredBy']);
      allow delete: if false;
    }

    // Per-admin "last opened the staff room" marker. Keyed by the reader's own
    // uid — every admin is a participant here, so each needs their own unread
    // state rather than one shared per-thread marker.
    match /teamChatReads/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }

    // Athlete groups: the coach's roster cohorts (a winter camp, a travel
    // team). Admin-only in both directions — an athlete has no view that
    // shows a group, and membership itself lives on users/{uid}.groupIds,
    // which is already admin-write-only (the athlete's self-write there is
    // capped to photoURL). Nothing to add on the athlete side.
    match /athleteGroups/{groupId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Exercise library: coach-tooling data (name/category -> last-used
    // sets/reps/notes/video URL) that powers the Program Editor's autofill
    // suggestions. Admin-only — athletes never see or need this.
    match /exerciseLibrary/{entryId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Video filming punch-list (superior-filming site): coach-tooling data,
    // no PII - exercise names, usage counts, and YouTube links. Reachable
    // only via an unlisted hosting URL, same trust model as the booking
    // site's other low-sensitivity collections, so anonymous sign-in
    // (isAuth() covers it) is enough - no separate login flow needed for
    // an internal punch-list. Deliberately isAuth(), not isAthlete(): the
    // filming tool's users are anonymous, with no users/{uid} doc for
    // role() to read.
    match /filmingExercises/{exerciseId} {
      allow read, write: if isAuth();
    }

    // Facility scheduling: everyone signed in can browse slots (to see
    // availability); only admins create/delete a slot or edit its own
    // fields (date/time/capacity/notes). bookedCount is the one field an
    // athlete can touch themselves, and only in lockstep with their own
    // booking doc in the same transaction (see bookFacilitySlot /
    // cancelFacilityBooking in firestore.js):
    //   +1 only if their booking doc didn't exist before and does after,
    //   -1 only if it existed before and doesn't after.
    // Without that pairing an athlete could fake-fill a slot to lock others
    // out, or decrement it to overbook. The booking rules below enforce the
    // same pairing from the other side, so neither write can land alone.
    //
    // isAthlete(), not isAuth(): the web API key is public, so anyone can
    // mint a role-less Auth account over REST.
    function slotPath(slotId) {
      return /databases/$(database)/documents/facilitySlots/$(slotId);
    }
    function myBookingPath(slotId) {
      return /databases/$(database)/documents/facilitySlots/$(slotId)/bookings/$(request.auth.uid);
    }

    match /facilitySlots/{slotId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAthlete() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedCount']) &&
        request.resource.data.bookedCount >= 0 &&
        request.resource.data.bookedCount <= resource.data.capacity &&
        (
          (request.resource.data.bookedCount == resource.data.bookedCount + 1 &&
           !exists(myBookingPath(slotId)) && existsAfter(myBookingPath(slotId))) ||
          (request.resource.data.bookedCount == resource.data.bookedCount - 1 &&
           exists(myBookingPath(slotId)) && !existsAfter(myBookingPath(slotId)))
        )
      );

      // One doc per athlete (doc id = their uid) under the slot they
      // booked — admins see the full roster, an athlete only their own.
      // No update rule: a booking is created or deleted, never edited.
      match /bookings/{uid} {
        allow read:   if isAdmin() || (isAuth() && request.auth.uid == uid);
        allow create: if isAdmin() || (
          isAthlete() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['bookedAt', 'athleteName']) &&
          getAfter(slotPath(slotId)).data.bookedCount == get(slotPath(slotId)).data.bookedCount + 1
        );
        // The slot-gone branch lets an athlete clear a booking left behind
        // when a coach deletes a slot that still had people in it.
        allow delete: if isAdmin() || (
          isAthlete() && request.auth.uid == uid && (
            !exists(slotPath(slotId)) ||
            getAfter(slotPath(slotId)).data.bookedCount == get(slotPath(slotId)).data.bookedCount - 1
          )
        );
      }
    }

    // Denormalized mirror of an athlete's own bookings, written in the same
    // transaction as the real booking doc above — exists purely so "My
    // Bookings" is a plain read of the athlete's own subcollection instead
    // of a collection-group query. Fully scoped to the athlete's own uid,
    // same shape as dataLogs/completions/exerciseWeights.
    match /facilityBookingsByAthlete/{uid}/slots/{slotId} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (isAthlete() && request.auth.uid == uid);
    }

    // Proof that a cancellation really happened.
    //
    // The booking-alert script (apps-script/booking-notify.gs) can verify a
    // NEW booking by reading the booking doc, but a cancellation deletes the
    // very thing that would prove it — so it used to email the coach a "late
    // cancellation" for any slot an athlete named, including ones they never
    // booked. This receipt closes that: it can only be created in the same
    // write that deletes the athlete's own booking (exists before,
    // gone after), which is exactly what cancelFacilityBooking does and is
    // not something a caller can fake. The script reads it back as the
    // athlete before sending anything.
    //
    // Never updated or deleted by an athlete — a receipt that can be edited
    // proves nothing.
    match /facilityCancellations/{uid}/slots/{slotId} {
      allow read:   if isAdmin() || (isAuth() && request.auth.uid == uid);
      // Admins too: a coach cancelling on an athlete's behalf goes through the
      // same transaction (see deleteAthleteCompletely), and the pairing check
      // can't apply to them since the booking being deleted isn't theirs.
      allow create: if isAdmin() || (
        isAthlete() && request.auth.uid == uid &&
        exists(myBookingPath(slotId)) && !existsAfter(myBookingPath(slotId))
      );
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Recurring weekly availability patterns a coach generates concrete
    // facilitySlots from (see generateSeriesSlots in firestore.js).
    // Admin-only in every direction — athletes only ever see the slots a
    // series has generated, never the series/pattern itself.
    match /facilityRecurringSeries/{seriesId} {
      allow read, write: if isAdmin();
    }

    // App settings: admin-only, except settings/public — the landing page's
    // inquiry form needs to read its Apps Script URL while signed out. Treat
    // everything there as public: the scripts behind those URLs have to
    // defend themselves (see apps-script/), not rely on the URL staying hidden.
    match /settings/{docId} {
      allow read:  if isAdmin() || docId == 'public';
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Assessment booking (no-account intake for new athletes, added for
    // the Nov/Dec onboarding wave). Bookers are anonymous Firebase Auth
    // users (signInAnonymously — no password, no email, no real account),
    // so isAuth() covers them but isAdmin()/isAthlete() correctly do not.
    // Same "rules-enforced bounded counter, no Cloud Function" shape as
    // facilitySlots above, since this project has no Cloud Functions
    // deployed and this pattern is already the established, proven one
    // here.
    //
    // Restored TWICE now after a separate rules deploy (unrelated to the
    // booking site) replaced the whole ruleset and silently dropped this
    // section, taking the live booking site down site-wide: first on
    // 2026-09-19, again on 2026-09-21 (caught and re-restored 2026-09-22).
    // If you're about to `firebase deploy --only firestore:rules` from a
    // checkout that doesn't have this block, you will do that again —
    // pull the live rules first, don't deploy from a stale local copy.
    // ------------------------------------------------------------------

    // Slot inventory the coach defines (date/time/capacity). No PII lives
    // on these docs, so any signed-in caller (anonymous included) can read
    // them to see what's open. Only an admin edits the inventory itself;
    // bookedCount can additionally be bumped by exactly +1 by the anonymous
    // booking flow, mirroring facilitySlots' ±1 pattern but one-directional
    // (bookers never cancel their own row here — see assessmentBookings).
    match /assessmentSlots/{slotId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      // +1 (a new booking) only into a slot that's still active and has
      // room; -1 (a cancel/reschedule releasing this slot) is allowed
      // regardless of active, since letting a seat go is always safe and
      // the coach may have since closed the slot out from under it.
      allow update: if isAdmin() || (
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedCount']) &&
        (
          (request.resource.data.bookedCount == resource.data.bookedCount + 1 &&
           request.resource.data.bookedCount <= resource.data.capacity &&
           resource.data.active == true) ||
          (request.resource.data.bookedCount == resource.data.bookedCount - 1 &&
           request.resource.data.bookedCount >= 0)
        )
      );
    }

    // The actual booking record — athlete/parent contact info. This is
    // real PII for people who are not yet accounts, so the collection can
    // never be listed/enumerated by anyone but the coach. A single
    // document CAN be fetched by anyone signed in (anonymous included) —
    // but only if they already know its exact id, which is what makes the
    // "manage your booking" link work from any device without an account.
    // A Firestore auto-id has ~119 bits of entropy and is never surfaced
    // anywhere but that one link, so this is the same trust model as any
    // other unlisted/private link (a Stripe payment link, an unlisted
    // video) — safe specifically because list stays admin-only below, so
    // there's no way to discover an id you weren't given.
    //
    // create is intentionally strict and allowlisted field-by-field so a
    // crafted request can't smuggle in extra fields, flip its own status,
    // or backdate itself:
    //  - hp (honeypot) must be sent and must be exactly '' — a hidden
    //    field real visitors never see or fill; anything else in it means
    //    a bot filled every input it could find, and the write is rejected.
    //  - status can only ever be created as 'pending' — never set by the
    //    client to anything else; only the coach (isAdmin) can change it.
    //  - createdByUid must equal the caller's own anonymous uid, and
    //    createdAt must be the server timestamp, not a client-supplied one.
    //
    // Self-service update (the manage-link page) is deliberately narrow:
    // it can only move a booking between 'pending' and 'cancelled', never
    // touch anything else, and can never reopen a 'converted' record —
    // once the coach has turned someone into a real account, this link
    // stops being able to change anything.
    match /assessmentBookings/{bookingId} {
      allow get: if isAuth();
      allow list: if isAdmin();
      allow create: if isAuth() &&
        request.resource.data.keys().hasOnly([
          'slotId', 'athleteName', 'athleteAge', 'parentName', 'parentPhone',
          'parentEmail', 'notes', 'status', 'createdByUid', 'createdAt', 'hp'
        ]) &&
        request.resource.data.hp == '' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.slotId is string && request.resource.data.slotId.size() > 0 &&
        request.resource.data.athleteName is string &&
        request.resource.data.athleteName.size() > 0 && request.resource.data.athleteName.size() <= 80 &&
        request.resource.data.parentName is string &&
        request.resource.data.parentName.size() > 0 && request.resource.data.parentName.size() <= 80 &&
        request.resource.data.parentPhone is string &&
        request.resource.data.parentPhone.size() > 0 && request.resource.data.parentPhone.size() <= 30 &&
        request.resource.data.parentEmail is string && request.resource.data.parentEmail.size() <= 120 &&
        request.resource.data.athleteAge is string && request.resource.data.athleteAge.size() <= 10 &&
        request.resource.data.notes is string && request.resource.data.notes.size() <= 500 &&
        get(/databases/$(database)/documents/assessmentSlots/$(request.resource.data.slotId)).data.active == true;
      allow update: if isAdmin() || (
        isAuth() &&
        resource.data.status != 'converted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slotId', 'status', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        (
          // cancel: status -> 'cancelled', slotId untouched (kept for history)
          (request.resource.data.status == 'cancelled' &&
           request.resource.data.slotId == resource.data.slotId) ||
          // book/rebook/reschedule: status -> 'pending' into a real, active slot
          (request.resource.data.status == 'pending' &&
           request.resource.data.slotId is string && request.resource.data.slotId.size() > 0 &&
           get(/databases/$(database)/documents/assessmentSlots/$(request.resource.data.slotId)).data.active == true)
        )
      );
      allow delete: if isAdmin();
    }

    // One lock doc per anonymous uid (doc id == the uid), created in the
    // same client transaction as the booking above. Its rule requires the
    // doc not already exist, which caps a single anonymous browser
    // identity to one assessment booking ever — a cheap, real backstop
    // against one tab spamming the form on repeat submits, on top of the
    // honeypot above. Not a substitute for App Check, just defense in depth.
    match /assessmentBookingLocks/{uid} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow create: if isAuth() && request.auth.uid == uid && !exists(/databases/$(database)/documents/assessmentBookingLocks/$(uid));
      allow update, delete: if isAdmin();
    }
  }
}

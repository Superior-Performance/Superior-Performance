rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requester signed in?
    function isAuth() { return request.auth != null; }

    // Helper: read the requester's role from their user doc
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isAuth() && role() == 'admin'; }
    function isAthlete() { return isAuth() && role() == 'athlete'; }

    // Users: admins can read/write all; athletes can read only their own doc.
    // Writes are otherwise admin-only — role/programTypes living on this doc
    // make a general self-write a privilege escalation risk — except an
    // athlete may update their OWN doc's photoURL and nothing else (profile
    // photo upload, see AccountPage). affectedKeys().hasOnly(['photoURL'])
    // rejects any write that touches a second field in the same call, so
    // this can't be piggybacked into changing role/etc.
    match /users/{uid} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (
        isAuth() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL'])
      );
    }

    // Programs: admins full access; athletes can only read their own, and only
    // once it's active — draft programs awaiting coach review stay admin-only
    // even for the athlete they're assigned to.
    match /programs/{programId} {
      allow read:  if isAdmin() || (isAthlete() && resource.data.athleteId == request.auth.uid && resource.data.active == true);
      allow write: if isAdmin();
    }

    // Data logs: admins read all; athletes read/write their own
    match /dataLogs/{uid}/entries/{entryId} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (isAuth() && request.auth.uid == uid);
    }

    // Assessments: admins full access; athletes read-only their own
    match /assessments/{uid} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Completions: athletes write their own; admins read and write all.
    // Admin writes are needed so editing a live program can move an athlete's
    // existing completions onto stable exercise-id keys (see utils/programIds),
    // and so a coach can correct a mis-tapped checkmark.
    match /completions/{uid}/weeks/{key} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (isAuth() && request.auth.uid == uid);
    }

    // Athlete-owned UI preferences — dismissed banners and the like. Kept out
    // of users/{uid} on purpose: that doc holds role and is admin-write-only,
    // and nothing here is security-relevant.
    match /athletePrefs/{uid} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (isAuth() && request.auth.uid == uid);
    }

    // Exercise weight tracking — one editable "this week's weight" value per
    // exercise instance, logged inline on the athlete's program tab so they
    // don't have to leave it mid-workout. Not a history (see dataLogs for
    // that) — same read/write shape as completions.
    match /exerciseWeights/{uid}/entries/{key} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (isAuth() && request.auth.uid == uid);
    }

    // Chat — one thread per athlete, shared with their coach. Admins can
    // read/write every thread; an athlete can only read/write their own.
    match /chats/{athleteUid}/messages/{messageId} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == athleteUid);
      allow write: if isAdmin() || (isAuth() && request.auth.uid == athleteUid);
    }

    // Admin-only "coach last opened this thread" marker — the athlete side
    // has no unread state to track, so no athlete-uid branch here at all.
    match /chatReads/{athleteUid} {
      allow read, write: if isAdmin();
    }

    // Team chat: the staff room. Admin-only end to end — athletes have no
    // business reading it and there is deliberately no athlete branch, unlike
    // /chats above. Scheduled Claude agents reach this through an admin
    // credential too, so they need no separate carve-out.
    //
    // Update is restricted to `answeredBy` alone: an agent marks a message
    // as handled, but nobody (agent or human) gets to silently rewrite the
    // text of a message already sitting in everyone else's scrollback.
    // Deletes are refused outright for the same reason.
    match /teamChat/{messageId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answeredBy']);
      allow delete: if false;
    }

    // Per-admin "last opened the staff room" marker. Keyed by the reader's own
    // uid — every admin is a participant here, so each needs their own unread
    // state rather than one shared per-thread marker.
    match /teamChatReads/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }

    // Athlete groups: the coach's roster cohorts (a winter camp, a travel
    // team). Admin-only in both directions — an athlete has no view that
    // shows a group, and membership itself lives on users/{uid}.groupIds,
    // which is already admin-write-only (the athlete's self-write there is
    // capped to photoURL). Nothing to add on the athlete side.
    match /athleteGroups/{groupId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Exercise library: coach-tooling data (name/category -> last-used
    // sets/reps/notes/video URL) that powers the Program Editor's autofill
    // suggestions. Admin-only — athletes never see or need this.
    match /exerciseLibrary/{entryId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Facility scheduling: everyone signed in can browse slots (to see
    // availability); only admins create/delete a slot or edit its own
    // fields (date/time/capacity/notes). bookedCount is the one field an
    // athlete can touch themselves, and only in lockstep with their own
    // booking doc in the same transaction (see bookFacilitySlot /
    // cancelFacilityBooking in firestore.js):
    //   +1 only if their booking doc didn't exist before and does after,
    //   -1 only if it existed before and doesn't after.
    // Without that pairing an athlete could fake-fill a slot to lock others
    // out, or decrement it to overbook. The booking rules below enforce the
    // same pairing from the other side, so neither write can land alone.
    //
    // isAthlete(), not isAuth(): the web API key is public, so anyone can
    // mint a role-less Auth account over REST.
    function slotPath(slotId) {
      return /databases/$(database)/documents/facilitySlots/$(slotId);
    }
    function myBookingPath(slotId) {
      return /databases/$(database)/documents/facilitySlots/$(slotId)/bookings/$(request.auth.uid);
    }

    match /facilitySlots/{slotId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAthlete() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedCount']) &&
        request.resource.data.bookedCount >= 0 &&
        request.resource.data.bookedCount <= resource.data.capacity &&
        (
          (request.resource.data.bookedCount == resource.data.bookedCount + 1 &&
           !exists(myBookingPath(slotId)) && existsAfter(myBookingPath(slotId))) ||
          (request.resource.data.bookedCount == resource.data.bookedCount - 1 &&
           exists(myBookingPath(slotId)) && !existsAfter(myBookingPath(slotId)))
        )
      );

      // One doc per athlete (doc id = their uid) under the slot they
      // booked — admins see the full roster, an athlete only their own.
      // No update rule: a booking is created or deleted, never edited.
      match /bookings/{uid} {
        allow read:   if isAdmin() || (isAuth() && request.auth.uid == uid);
        allow create: if isAdmin() || (
          isAthlete() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['bookedAt', 'athleteName']) &&
          getAfter(slotPath(slotId)).data.bookedCount == get(slotPath(slotId)).data.bookedCount + 1
        );
        // The slot-gone branch lets an athlete clear a booking left behind
        // when a coach deletes a slot that still had people in it.
        allow delete: if isAdmin() || (
          isAthlete() && request.auth.uid == uid && (
            !exists(slotPath(slotId)) ||
            getAfter(slotPath(slotId)).data.bookedCount == get(slotPath(slotId)).data.bookedCount - 1
          )
        );
      }
    }

    // Denormalized mirror of an athlete's own bookings, written in the same
    // transaction as the real booking doc above — exists purely so "My
    // Bookings" is a plain read of the athlete's own subcollection instead
    // of a collection-group query. Fully scoped to the athlete's own uid,
    // same shape as dataLogs/completions/exerciseWeights.
    match /facilityBookingsByAthlete/{uid}/slots/{slotId} {
      allow read:  if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow write: if isAdmin() || (isAuth() && request.auth.uid == uid);
    }

    // Recurring weekly availability patterns a coach generates concrete
    // facilitySlots from (see generateSeriesSlots in firestore.js).
    // Admin-only in every direction — athletes only ever see the slots a
    // series has generated, never the series/pattern itself.
    match /facilityRecurringSeries/{seriesId} {
      allow read, write: if isAdmin();
    }

    // App settings: admin-only, except settings/public — the landing page's
    // inquiry form needs to read its Apps Script URL while signed out. Treat
    // everything there as public: the scripts behind those URLs have to
    // defend themselves (see apps-script/), not rely on the URL staying hidden.
    match /settings/{docId} {
      allow read:  if isAdmin() || docId == 'public';
      allow write: if isAdmin();
    }
  }
}

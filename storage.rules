rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // profilePhotos/{uid}/avatar.jpg — one file per athlete, overwritten on
    // every new upload rather than accumulating old versions. Anyone signed
    // into the app can view (avatars show up on rosters/chat/etc. for both
    // roles); only the athlete themself or an admin can write or remove one
    // — mirrors firestore.rules' isAdmin() pattern via a cross-service
    // firestore.get() so a coach can also take down an inappropriate photo.
    match /profilePhotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.uid == uid || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}

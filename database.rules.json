{
  "rules": {
    "chats": {
      "$athleteUid": {
        "messages": {
          ".read": "auth != null && (auth.uid == $athleteUid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          ".write": "auth != null && (auth.uid == $athleteUid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
        },
        "readBy": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
